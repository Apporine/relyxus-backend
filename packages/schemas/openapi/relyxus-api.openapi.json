{
  "components": {
    "schemas": {
      "CurrentIdentity": {
        "properties": {
          "authenticated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "2026-10-14T07:56:00Z"
            ],
            "title": "Authenticated At"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "Amira Haddad"
            ],
            "title": "Display Name"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "sre.lead@bank.example"
            ],
            "title": "Email"
          },
          "issuer": {
            "examples": [
              "https://id.bank.example/realms/relyxus"
            ],
            "title": "Issuer",
            "type": "string"
          },
          "subject": {
            "examples": [
              "5c2f6b1e-0d4a-4f8e-9a7b-3c1d2e4f5a6b"
            ],
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "issuer",
          "subject",
          "email",
          "display_name",
          "authenticated_at"
        ],
        "title": "CurrentIdentity",
        "type": "object"
      },
      "DependencyCheck": {
        "properties": {
          "is_reachable": {
            "examples": [
              true
            ],
            "title": "Is Reachable",
            "type": "boolean"
          },
          "name": {
            "examples": [
              "postgresql"
            ],
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "is_reachable"
        ],
        "title": "DependencyCheck",
        "type": "object"
      },
      "FieldProblem": {
        "properties": {
          "field": {
            "examples": [
              "body.title"
            ],
            "title": "Field",
            "type": "string"
          },
          "message": {
            "examples": [
              "Field required"
            ],
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "FieldProblem",
        "type": "object"
      },
      "HealthStatus": {
        "enum": [
          "ok"
        ],
        "title": "HealthStatus",
        "type": "string"
      },
      "LivenessReport": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus",
            "examples": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ],
        "title": "LivenessReport",
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "code": {
            "examples": [
              "NOT_FOUND"
            ],
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "examples": [
              "5f0c2b1e-6a4d-4c8e-9b7a-1d2e3f4a5b6c"
            ],
            "title": "Correlation Id",
            "type": "string"
          },
          "detail": {
            "examples": [
              "No incident with this ID is visible to you."
            ],
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldProblem"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              null
            ],
            "title": "Errors"
          },
          "instance": {
            "examples": [
              "/api/v1/incidents/0192f0c4-7d1e-7a3b-9c2d-5e6f7a8b9c0d"
            ],
            "title": "Instance",
            "type": "string"
          },
          "status": {
            "examples": [
              404
            ],
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "examples": [
              "Not found"
            ],
            "title": "Title",
            "type": "string"
          },
          "type": {
            "examples": [
              "urn:relyxus:problem:not-found"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "correlation_id"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "ReadinessReport": {
        "properties": {
          "checks": {
            "examples": [
              [
                {
                  "is_reachable": true,
                  "name": "postgresql"
                }
              ]
            ],
            "items": {
              "$ref": "#/components/schemas/DependencyCheck"
            },
            "title": "Checks",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/ReadinessStatus",
            "examples": [
              "ready"
            ]
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessReport",
        "type": "object"
      },
      "ReadinessStatus": {
        "enum": [
          "ready",
          "not_ready"
        ],
        "title": "ReadinessStatus",
        "type": "string"
      },
      "SuccessEnvelope_CurrentIdentity_": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CurrentIdentity"
          },
          "success": {
            "const": true,
            "default": true,
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "data"
        ],
        "title": "SuccessEnvelope[CurrentIdentity]",
        "type": "object"
      },
      "SuccessEnvelope_LivenessReport_": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/LivenessReport"
          },
          "success": {
            "const": true,
            "default": true,
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "data"
        ],
        "title": "SuccessEnvelope[LivenessReport]",
        "type": "object"
      },
      "SuccessEnvelope_ReadinessReport_": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ReadinessReport"
          },
          "success": {
            "const": true,
            "default": true,
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "data"
        ],
        "title": "SuccessEnvelope[ReadinessReport]",
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Relyxus API",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/me": {
      "get": {
        "description": "The verified identity behind the access token. Requires a Bearer token.",
        "operationId": "get_current_identity_api_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope_CurrentIdentity_"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Current identity",
        "tags": [
          "identity"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Returns 200 while the process is running. Does not check dependencies.",
        "operationId": "get_liveness_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope_LivenessReport_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "description": "Returns 200 only when every required dependency is reachable; 503 otherwise.",
        "operationId": "get_readiness_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope_ReadinessReport_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope_ReadinessReport_"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    }
  }
}
