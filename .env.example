# Copy to .env for local development. Never commit .env (context.md §10).
RELYXUS_ENVIRONMENT=local
RELYXUS_PUBLIC_BASE_URL=http://localhost:8000
RELYXUS_DATABASE_URL=postgresql+psycopg://relyxus:relyxus-local@localhost:5432/relyxus
RELYXUS_OIDC_ISSUER_URL=http://localhost:8080/realms/relyxus
RELYXUS_OIDC_AUDIENCE=relyxus-api
# Optional commercial licence runtime (trusted key-set document v1 + install binding)
# RELYXUS_LICENSE_TRUSTED_KEY_SET_PATH=packages/licensing/tests/vectors/golden-trusted-key-set-v1.json
# RELYXUS_LICENSE_CUSTOMER_ID=
# RELYXUS_LICENSE_DEPLOYMENT_ID=
# RELYXUS_LICENSE_READINESS_ORGANIZATION_ID=
# Optional
# RELYXUS_OIDC_JWKS_URL=  (defaults to <issuer>/protocol/openid-connect/certs)
# RELYXUS_DATABASE_PROBE_TIMEOUT_SECONDS=2.0
# Integration tests (pytest) use a separate database:
# RELYXUS_TEST_DATABASE_URL=postgresql+psycopg://relyxus:relyxus-local@localhost:5432/relyxus_test
