{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StartAndPollTrialBuild",
      "Effect": "Allow",
      "Action": ["codebuild:StartBuild", "codebuild:BatchGetBuilds"],
      "Resource": "arn:aws:codebuild:ap-southeast-2:925234975399:project/relyxus-trial-build"
    },
    {
      "Sid": "UploadBuildSource",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::relyxus-cicd-source-925234975399/*"
    }
  ]
}
