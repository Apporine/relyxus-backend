# Copy to infra/aws/.env on the trial host. Never commit .env.
RELYXUS_ENVIRONMENT=local
RELYXUS_PUBLIC_BASE_URL=http://YOUR_PUBLIC_HOST
RELYXUS_DATABASE_URL=postgresql+psycopg://relyxus:relyxus-local@postgres:5432/relyxus
RELYXUS_OIDC_ISSUER_URL=http://YOUR_PUBLIC_HOST:8080/realms/relyxus
RELYXUS_OIDC_AUDIENCE=relyxus-api
