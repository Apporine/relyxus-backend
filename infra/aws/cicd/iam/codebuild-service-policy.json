{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BuildLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": [
        "arn:aws:logs:ap-southeast-2:925234975399:log-group:/relyxus/cicd/codebuild",
        "arn:aws:logs:ap-southeast-2:925234975399:log-group:/relyxus/cicd/codebuild:*"
      ]
    },
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushApiImage",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:PutImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload"
      ],
      "Resource": "arn:aws:ecr:ap-southeast-2:925234975399:repository/relyxus/api"
    },
    {
      "Sid": "ReadBuildSource",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::relyxus-cicd-source-925234975399/*"
    },
    {
      "Sid": "ListBuildSource",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::relyxus-cicd-source-925234975399"
    }
  ]
}
