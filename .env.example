# Copy to .env for local development. Never commit .env (context.md §10).
RELYXUS_ENVIRONMENT=local
RELYXUS_PUBLIC_BASE_URL=http://localhost:8000
RELYXUS_DATABASE_URL=postgresql+psycopg://relyxus:relyxus-local@localhost:5432/relyxus
# Optional
# RELYXUS_DATABASE_PROBE_TIMEOUT_SECONDS=2.0
# Integration tests (pytest) use a separate database:
# RELYXUS_TEST_DATABASE_URL=postgresql+psycopg://relyxus:relyxus-local@localhost:5432/relyxus_test
