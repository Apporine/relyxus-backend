{
  "components": {
    "schemas": {
      "CurrentIdentity": {
        "properties": {
          "authenticated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "2026-10-14T07:56:00Z"
            ],
            "title": "Authenticated At"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "Amira Haddad"
            ],
            "title": "Display Name"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "sre.lead@bank.example"
            ],
            "title": "Email"
          },
          "issuer": {
            "examples": [
              "https://id.bank.example/realms/relyxus"
            ],
            "title": "Issuer",
            "type": "string"
          },
          "subject": {
            "examples": [
              "5c2f6b1e-0d4a-4f8e-9a7b-3c1d2e4f5a6b"
            ],
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "issuer",
          "subject",
          "email",
          "display_name",
          "authenticated_at"
        ],
        "title": "CurrentIdentity",
        "type": "object"
      },
      "DependencyCheck": {
        "properties": {
          "is_reachable": {
            "examples": [
              true
            ],
            "title": "Is Reachable",
            "type": "boolean"
          },
          "name": {
            "examples": [
              "postgresql"
            ],
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "is_reachable"
        ],
        "title": "DependencyCheck",
        "type": "object"
      },
      "FieldProblem": {
        "properties": {
          "field": {
            "examples": [
              "body.title"
            ],
            "title": "Field",
            "type": "string"
          },
          "message": {
            "examples": [
              "Field required"
            ],
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "FieldProblem",
        "type": "object"
      },
      "HealthStatus": {
        "enum": [
          "ok"
        ],
        "title": "HealthStatus",
        "type": "string"
      },
      "ListEnvelope_WorkspaceSummary_": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/WorkspaceSummary"
            },
            "title": "Data",
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/ListMeta"
          },
          "success": {
            "const": true,
            "default": true,
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "ListEnvelope[WorkspaceSummary]",
        "type": "object"
      },
      "ListMeta": {
        "description": "No `total`: a count could reveal restricted incidents (MPS-15.07, ADR-0003 \u00a72).",
        "properties": {
          "limit": {
            "examples": [
              20
            ],
            "title": "Limit",
            "type": "integer"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "eyJ2IjoxLCJwIjpbIjIwMjYtMTAtMTQiXX0"
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "next_cursor",
          "limit"
        ],
        "title": "ListMeta",
        "type": "object"
      },
      "LivenessReport": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus",
            "examples": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ],
        "title": "LivenessReport",
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "code": {
            "examples": [
              "NOT_FOUND"
            ],
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "examples": [
              "5f0c2b1e-6a4d-4c8e-9b7a-1d2e3f4a5b6c"
            ],
            "title": "Correlation Id",
            "type": "string"
          },
          "detail": {
            "examples": [
              "No incident with this ID is visible to you."
            ],
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldProblem"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              null
            ],
            "title": "Errors"
          },
          "instance": {
            "examples": [
              "/api/v1/incidents/0192f0c4-7d1e-7a3b-9c2d-5e6f7a8b9c0d"
            ],
            "title": "Instance",
            "type": "string"
          },
          "status": {
            "examples": [
              404
            ],
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "examples": [
              "Not found"
            ],
            "title": "Title",
            "type": "string"
          },
          "type": {
            "examples": [
              "urn:relyxus:problem:not-found"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "correlation_id"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "ReadinessReport": {
        "properties": {
          "checks": {
            "examples": [
              [
                {
                  "is_reachable": true,
                  "name": "postgresql"
                }
              ]
            ],
            "items": {
              "$ref": "#/components/schemas/DependencyCheck"
            },
            "title": "Checks",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/ReadinessStatus",
            "examples": [
              "ready"
            ]
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessReport",
        "type": "object"
      },
      "ReadinessStatus": {
        "enum": [
          "ready",
          "not_ready"
        ],
        "title": "ReadinessStatus",
        "type": "string"
      },
      "SuccessEnvelope_CurrentIdentity_": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CurrentIdentity"
          },
          "success": {
            "const": true,
            "default": true,
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "data"
        ],
        "title": "SuccessEnvelope[CurrentIdentity]",
        "type": "object"
      },
      "SuccessEnvelope_LivenessReport_": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/LivenessReport"
          },
          "success": {
            "const": true,
            "default": true,
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "data"
        ],
        "title": "SuccessEnvelope[LivenessReport]",
        "type": "object"
      },
      "SuccessEnvelope_ReadinessReport_": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ReadinessReport"
          },
          "success": {
            "const": true,
            "default": true,
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "data"
        ],
        "title": "SuccessEnvelope[ReadinessReport]",
        "type": "object"
      },
      "SuccessEnvelope_WorkspaceSummary_": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/WorkspaceSummary"
          },
          "success": {
            "const": true,
            "default": true,
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "data"
        ],
        "title": "SuccessEnvelope[WorkspaceSummary]",
        "type": "object"
      },
      "WorkspaceRole": {
        "description": "The nine built-in roles (MPS-14.02-14.09, single definitions MPS-26.02).",
        "enum": [
          "owner",
          "admin",
          "security_admin",
          "compliance_officer",
          "policy_owner",
          "incident_commander",
          "responder",
          "viewer",
          "auditor"
        ],
        "title": "WorkspaceRole",
        "type": "string"
      },
      "WorkspaceSummary": {
        "description": "A workspace the caller can open, with the roles they hold there.",
        "properties": {
          "data_residency_region": {
            "examples": [
              "eu-west-2"
            ],
            "title": "Data Residency Region",
            "type": "string"
          },
          "organization_id": {
            "examples": [
              "0192f0c4-0000-7000-8000-000000000001"
            ],
            "format": "uuid",
            "title": "Organization Id",
            "type": "string"
          },
          "organization_name": {
            "examples": [
              "Alpha Bank"
            ],
            "title": "Organization Name",
            "type": "string"
          },
          "roles": {
            "examples": [
              [
                "incident_commander",
                "responder"
              ]
            ],
            "items": {
              "$ref": "#/components/schemas/WorkspaceRole"
            },
            "title": "Roles",
            "type": "array"
          },
          "workspace_id": {
            "examples": [
              "0192f0c4-7d1e-7a3b-9c2d-5e6f7a8b9c0d"
            ],
            "format": "uuid",
            "title": "Workspace Id",
            "type": "string"
          },
          "workspace_key": {
            "examples": [
              "payments-eu"
            ],
            "title": "Workspace Key",
            "type": "string"
          },
          "workspace_name": {
            "examples": [
              "Payments EU"
            ],
            "title": "Workspace Name",
            "type": "string"
          }
        },
        "required": [
          "workspace_id",
          "workspace_key",
          "workspace_name",
          "data_residency_region",
          "organization_id",
          "organization_name",
          "roles"
        ],
        "title": "WorkspaceSummary",
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Relyxus API",
    "version": "0.4.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/me": {
      "get": {
        "description": "The verified identity behind the access token. Requires a Bearer token.",
        "operationId": "get_current_identity_api_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope_CurrentIdentity_"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Current identity",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/me/workspaces": {
      "get": {
        "description": "Every workspace the caller holds a role in, across organisations, with those roles. Backs the workspace picker. Cursor-paginated; no total is returned.",
        "operationId": "list_my_workspaces_api_v1_me_workspaces_get",
        "parameters": [
          {
            "description": "Opaque cursor from `meta.next_cursor`",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 512,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Opaque cursor from `meta.next_cursor`",
              "title": "Cursor"
            }
          },
          {
            "description": "Items per page (1-100)",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "description": "Items per page (1-100)",
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListEnvelope_WorkspaceSummary_"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Workspaces I can open",
        "tags": [
          "workspaces"
        ]
      }
    },
    "/api/v1/workspaces/current": {
      "get": {
        "description": "The workspace named in the `X-Relyxus-Workspace-Id` header, verified against the caller's role grants, with those roles. Unknown and forbidden workspaces both return 403.",
        "operationId": "get_current_workspace_api_v1_workspaces_current_get",
        "parameters": [
          {
            "in": "header",
            "name": "X-Relyxus-Workspace-Id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "X-Relyxus-Workspace-Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope_WorkspaceSummary_"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Current workspace",
        "tags": [
          "workspaces"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Returns 200 while the process is running. Does not check dependencies.",
        "operationId": "get_liveness_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope_LivenessReport_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "description": "Returns 200 only when every required dependency is reachable; 503 otherwise.",
        "operationId": "get_readiness_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope_ReadinessReport_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {}
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope_ReadinessReport_"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    }
  }
}
